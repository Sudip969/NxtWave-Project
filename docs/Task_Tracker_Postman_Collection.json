{
  "info": {
    "_postman_id": "9a752be3-3004-45ea-beab-69f60f96ff6f",
    "name": "NxtWave Team Task Tracker API",
    "description": "Comprehensive API collection for the SDE II Multi-Tenant Team Task Tracker REST API. Includes complete documentation for Authentication, Projects, Tasks, and Server-Sent Events (SSE) live notifications.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@nxtwave.com\",\n  \"password\": \"admin123\",\n  \"name\": \"Alice Admin\",\n  \"organizationName\": \"NxtWave Corp\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Registers a new user inside the system. If the organizationName does not exist, a new organization is created automatically. Role can be ADMIN, MANAGER, or MEMBER."
          },
          "response": []
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.data && response.data.accessToken) {",
                  "    pm.collectionVariables.set(\"accessToken\", response.data.accessToken);",
                  "    pm.collectionVariables.set(\"refreshToken\", response.data.refreshToken);",
                  "    console.log(\"Access and Refresh tokens saved to collection variables successfully!\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@nxtwave.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Authenticates user credentials. On success, returns an accessToken (JWT 15m expiration) and a refreshToken (JWT 7d expiration). Also runs a Postman Test Script to automatically store the tokens in collection variables."
          },
          "response": []
        },
        {
          "name": "Refresh Token Rotation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.data && response.data.accessToken) {",
                  "    pm.collectionVariables.set(\"accessToken\", response.data.accessToken);",
                  "    pm.collectionVariables.set(\"refreshToken\", response.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "Obtain a fresh access token and a rotated refresh token using the current active refresh token. Features replay protection (reusing a revoked/old refresh token immediately invalidates all active sessions for that user)."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Revokes the active refresh token and signs the user out cleanly."
          },
          "response": []
        },
        {
          "name": "Get Organization Users",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "users"
              ]
            },
            "description": "Retrieve all users belonging to the logged-in user's organization."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Projects",
      "item": [
        {
          "name": "Create Project",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Vite Kanban App Implementation\",\n  \"description\": \"Migrating current tracking flow to clean Vite client serving via Nginx and Docker Compose.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects"
              ]
            },
            "description": "Creates a new project in the organization. restricted exclusively to ADMIN and MANAGER roles."
          },
          "response": []
        },
        {
          "name": "Get Projects List",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects"
              ]
            },
            "description": "Returns all projects registered inside the active user's organization."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Tasks",
      "item": [
        {
          "name": "Create Task",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Implement SQLite Volume mounts in Docker Compose\",\n  \"description\": \"Add volumes array mapping host backend folder to internal folder to persist database.\",\n  \"priority\": \"HIGH\",\n  \"projectId\": \"replace-with-your-project-id\",\n  \"dueDate\": \"2026-12-31\",\n  \"assigneeId\": \"replace-with-your-assignee-user-id\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "description": "Creates a new task. restricted to ADMIN and MANAGER. Triggers immediate Redis list cache invalidation for the organization."
          },
          "response": []
        },
        {
          "name": "Get Tasks List (Scoped / Cached)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks?projectId=replace-with-project-id&page=1&limit=10&status=&priority=&assignee=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ],
              "query": [
                {
                  "key": "projectId",
                  "value": "replace-with-project-id"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": ""
                },
                {
                  "key": "priority",
                  "value": ""
                },
                {
                  "key": "assignee",
                  "value": ""
                }
              ]
            },
            "description": "Queries tasks in the organization with pagination and optional filtering by status, priority, or assignee ID.\n\n* **Caching Integration:** Bypasses SQLite and fetches instantly from Redis memory on cache hits.\n* **Access Scoping:** Members are automatically constrained to their assigned/created tasks."
          },
          "response": []
        },
        {
          "name": "Get Task Details By ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks/replace-with-task-id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "replace-with-task-id"
              ]
            },
            "description": "Fetches rich details for a single task including creator, assignee, and project details. Checks multi-tenant organization boundary and role permissions."
          },
          "response": []
        },
        {
          "name": "Update Task Card",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks/replace-with-task-id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "replace-with-task-id"
              ]
            },
            "description": "Modify task parameters or advance its state on the Kanban board.\n\n* **Dynamic RBAC:** Modifying fields (title, description, priority, assignee, due date) is restricted to ADMIN and MANAGER. Changing the status only is allowed for the assigned user, manager, or admin. Other members are blocked."
          },
          "response": []
        },
        {
          "name": "Delete Task",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks/replace-with-task-id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "replace-with-task-id"
              ]
            },
            "description": "Deletes the task from the database. Restricted exclusively to ADMIN and MANAGER roles."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Notifications (SSE)",
      "item": [
        {
          "name": "SSE Subscription Stream",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications/subscribe",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications",
                "subscribe"
              ]
            },
            "description": "Opens a persistent, real-time Server-Sent Events (SSE) connection stream. Whenever a task is updated or its status is transitioned by another team member, the assignee immediately receives a status notification payload."
          },
          "response": []
        }
      ]
    }
